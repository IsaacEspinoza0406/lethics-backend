NODE_ENV=development
PORT=3000
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=replace_me
MONGO_INITDB_ROOT_PASSWORD=replace_me
MONGODB_URI=mongodb://replace_me:replace_me@127.0.0.1:27017/lethics?authSource=admin
