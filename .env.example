# APLICACIÓN
NODE_ENV=development
PORT=3000

# MONGODB
# Sustituir marcadores; codificar caracteres especiales en las URI.
MONGO_PORT=27018
MONGO_INITDB_ROOT_USERNAME=replace_me
MONGO_INITDB_ROOT_PASSWORD=replace_me
MONGODB_URI=mongodb://replace_me:replace_me@localhost:27018/lethics?authSource=admin&replicaSet=lethics-rs

# REDIS
# Misma contraseña en REDIS_PASSWORD y REDIS_URL; producción exige rediss://.
REDIS_PASSWORD=replace_me
REDIS_PORT=6380
REDIS_URL=redis://:replace_me@127.0.0.1:6380
# En producción, elegir un namespace propio; development se rechaza.
RATE_LIMIT_NAMESPACE=development

# JWT Y SEGURIDAD
# Tres claves independientes, cada una de 32 bytes aleatorios en base64.
JWT_ACCESS_SECRET_BASE64=
VERIFICATION_CODE_HMAC_KEY_BASE64=
RATE_LIMIT_HMAC_KEY_BASE64=
JWT_ACCESS_ISSUER=lethics-local
JWT_ACCESS_AUDIENCE=lethics-api-local
JWT_ACCESS_TTL_SECONDS=900

# AUTENTICACIÓN Y COOKIES
# Activar tras comprobar índices, Redis, correo y topología autorizada.
AUTH_HTTP_ENABLED=false
AUTH_BEHIND_PROXY=false
# Valores operativos iniciales: refresh hasta siete días, recuperación hasta 15 minutos.
AUTH_REFRESH_TTL_SECONDS=604800
PASSWORD_RECOVERY_TTL_SECONDS=900
# Solo HTTP local; producción exige true y HTTPS.
AUTH_REFRESH_COOKIE_SECURE=false
# Origen EXACTO del frontend: esquema, host y puerto, sin ruta ni / final.
# 3001 es un ejemplo para evitar colisión con la API; acordarlo con frontend.
# Configurar Origin NO habilita CORS ni confianza en proxies.
# AUTH_BROWSER_ORIGIN=http://localhost:3001

# LÍMITES DE SOLICITUDES
# Ventanas en segundos. Valores existentes; no se modifican las políticas.
VERIFICATION_ACCOUNT_FAILURES_PER_HOUR=20
VERIFICATION_ACCOUNT_EMISSIONS_PER_HOUR=5
RATE_LIMIT_VERIFY_MAX=60
RATE_LIMIT_VERIFY_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_RESEND_MAX=20
RATE_LIMIT_RESEND_WINDOW_SECONDS=3600
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=600
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=600
RATE_LIMIT_LOGOUT_MAX=30
RATE_LIMIT_LOGOUT_WINDOW_SECONDS=600
RATE_LIMIT_PASSWORD_FORGOT_MAX=10
RATE_LIMIT_PASSWORD_FORGOT_WINDOW_SECONDS=600
RATE_LIMIT_PASSWORD_RESET_MAX=10
RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=600
RATE_LIMIT_PASSWORD_ACCOUNT_MAX=3
RATE_LIMIT_PASSWORD_ACCOUNT_WINDOW_SECONDS=3600

# CORREO SMTP
# Mantener disabled hasta configurar un servidor autorizado en el .env privado.
VERIFICATION_MAIL_TRANSPORT=disabled
# TLS implícito normalmente en 465; confirmar modo/puerto con el proveedor.
SMTP_SECURE=true
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=465
# SMTP_USER=replace_me
# SMTP_PASSWORD=replace_me
# SMTP_FROM=verificacion@example.invalid
# STARTTLS (normalmente 587): SMTP_SECURE=false; TLS continúa siendo obligatorio.
# No permitir fallback a texto plano ni certificados sin validar.

# PRUEBAS LOCALES
# Mailpit: node scripts/mailpit.cjs serve
# Copiar a la sesión SMTP y NODE_EXTRA_CA_CERTS impresos por el runner.
# El certificado temporal se carga al iniciar Node; no desactivar validación TLS.
# Solo credenciales ficticias: mailpit / mailpit-local-only.
# LETHICS_IDENTITY_TEST_URI=mongodb://usuario_ficticio:clave_ficticia@localhost:27018/admin?authSource=admin&replicaSet=lethics-rs
# LETHICS_REDIS_TEST_URL=redis://:clave_ficticia@localhost:6380
# OPENSSL_BIN=C:/ruta/a/openssl.exe
