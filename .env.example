NODE_ENV=development
PORT=3000
MONGO_PORT=27018
MONGO_INITDB_ROOT_USERNAME=replace_me
MONGO_INITDB_ROOT_PASSWORD=replace_me
MONGODB_URI=mongodb://replace_me:replace_me@localhost:27018/lethics?authSource=admin&replicaSet=lethics-rs
JWT_ACCESS_SECRET_BASE64=
JWT_ACCESS_ISSUER=lethics-local
JWT_ACCESS_AUDIENCE=lethics-api-local
JWT_ACCESS_TTL_SECONDS=900
# Clave independiente, 32 bytes aleatorios en base64; aún no utilizada por rutas públicas.
VERIFICATION_CODE_HMAC_KEY_BASE64=replace_me
VERIFICATION_ACCOUNT_FAILURES_PER_HOUR=20
VERIFICATION_ACCOUNT_EMISSIONS_PER_HOUR=5

# Redis aislado de desarrollo; sustituir ambos secretos con valores generados.
REDIS_PASSWORD=replace_me
REDIS_PORT=6380
REDIS_URL=redis://:replace_me@127.0.0.1:6380
RATE_LIMIT_HMAC_KEY_BASE64=
RATE_LIMIT_NAMESPACE=development
RATE_LIMIT_VERIFY_MAX=60
RATE_LIMIT_VERIFY_WINDOW_SECONDS=600
RATE_LIMIT_REGISTER_MAX=20
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_RESEND_MAX=20
RATE_LIMIT_RESEND_WINDOW_SECONDS=3600

# Incremento 5: activación explícita. El modo proxy continúa bloqueado.
AUTH_HTTP_ENABLED=false
AUTH_BEHIND_PROXY=false
VERIFICATION_MAIL_TRANSPORT=disabled
# Solo configurar con un servidor SMTP autorizado. Nunca pegar credenciales reales aquí.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=replace_me
# SMTP_PASSWORD=replace_me
# SMTP_FROM=verificacion@example.invalid

# Mailpit local (sin modificar los valores anteriores ni habilitar HTTP):
# node scripts/mailpit.cjs serve
# Copiar a la sesión los valores SMTP y NODE_EXTRA_CA_CERTS que imprime el comando.
# Credenciales exclusivamente ficticias: mailpit / mailpit-local-only.
# El certificado temporal debe cargarse al iniciar Node; no desactivar validación TLS.
# LETHICS_IDENTITY_TEST_URI=mongodb://usuario_ficticio:clave_ficticia@localhost:27018/admin?authSource=admin&replicaSet=lethics-rs
# LETHICS_REDIS_TEST_URL=redis://:clave_ficticia@localhost:6380
